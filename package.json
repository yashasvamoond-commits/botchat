{
  "name": "x-document-manager",
  "version": "1.0.0",
  "private": true,
  "description": "X Document Manager — a WhatsApp document manager, analyser and search bot for lawyers and anyone drowning in paperwork.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node --no-warnings src/server.js",
    "dev": "node --no-warnings --watch src/server.js",
    "seed": "node --no-warnings scripts/seed-demo.js",
    "test": "node --no-warnings --test",
    "sim": "node --no-warnings scripts/chat-cli.js",
    "ecourts": "node --no-warnings scripts/import-ecourts.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "busboy": "^1.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mammoth": "^1.9.0",
    "pdfjs-dist": "^4.10.38"
  }
}
