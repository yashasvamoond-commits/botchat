# ─────────────────────────────────────────────────────────────────────────────
# X DOCUMENT MANAGER — settings file
# Copy this file to ".env" and fill in only the lines you need.
# Every line is optional: the app runs offline out of the box.
# ─────────────────────────────────────────────────────────────────────────────

# Your name, used in greetings. (Not required.)
OWNER_NAME=Adv. Your Name

# Your WhatsApp number with country code, digits only. Example: 919876543210
# Anyone messaging the bot from another number is ignored (keeps your files private).
OWNER_PHONE=919876543210

# Extra numbers allowed to use the bot, comma separated. Leave empty for none.
ALLOWED_PHONES=

# ── WhatsApp Cloud API (official WhatsApp) ───────────────────────────────────
# Get these from https://developers.facebook.com/apps → your app → WhatsApp.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=xdocmanager-verify
WHATSAPP_APP_SECRET=

# ── Dashboard ────────────────────────────────────────────────────────────────
# Password for the private web dashboard. Leave empty to auto-generate one
# (it will be printed at startup and saved to data/dashboard-token.txt).
DASHBOARD_TOKEN=
PORT=3000

# ── Optional AI upgrade ──────────────────────────────────────────────────────
# The bot works fully without any AI key. If you add one, it writes better
# summaries, reads scanned photos, and answers questions in plain language.
# LLM_PROVIDER can be: openai | anthropic | openrouter | ollama
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# ── Optional OCR (scanned paper photos) ──────────────────────────────────────
# Path to the tesseract program if you install it. Example: /usr/bin/tesseract
TESSERACT_BIN=
